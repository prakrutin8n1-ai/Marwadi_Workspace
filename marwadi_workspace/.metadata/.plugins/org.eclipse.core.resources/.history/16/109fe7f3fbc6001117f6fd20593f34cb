
<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Student List</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            margin: 0;
            padding: 35px;
        }

        .container {
            max-width: 1000px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 12px #cccccc;
        }

        h2 {
            text-align: center;
            color: #1e3a8a;
            margin-bottom: 25px;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            gap: 10px;
        }

        .btn {
            display: inline-block;
            padding: 10px 16px;
            background: #2563eb;
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }

        .btn:hover {
            background: #1d4ed8;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #d1d5db;
            padding: 12px;
            text-align: left;
        }

        th {
            background: #2563eb;
            color: white;
        }

        tr:nth-child(even) {
            background: #f8fafc;
        }

        .empty {
            text-align: center;
            padding: 20px;
            color: #64748b;
        }

        .error {
            color: red;
            text-align: center;
        }

        @media (max-width: 650px) {
            body {
                padding: 10px;
            }

            .container {
                padding: 12px;
                overflow-x: auto;
            }

            table {
                min-width: 600px;
            }

            .top-bar {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <h2>Student Management System</h2>

    <p class="error">${error}</p>

    <div class="top-bar">
        <h3>Registered Students</h3>

        <a class="btn"
           href="${pageContext.request.contextPath}/register">
            + Add New Student
        </a>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Student Name</th>
                <th>Email</th>
                <th>Course</th>
            </tr>
        </thead>

        <tbody>

            <c:choose>
                <c:when test="${not empty students}">

                    <c:forEach var="s" items="${students}">
                        <tr>
                            <td><c:out value="${s.id}"/></td>
                            <td><c:out value="${s.name}"/></td>
                            <td><c:out value="${s.email}"/></td>
                            <td><c:out value="${s.course}"/></td>
                        </tr>
                    </c:forEach>

                </c:when>

                <c:otherwise>
                    <tr>
                        <td colspan="4" class="empty">
                            No students found. Please add a student.
                        </td>
                    </tr>
                </c:otherwise>
            </c:choose>

        </tbody>
    </table>

</div>

</body>
</html>
