<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>${pageTitle}</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            margin: 0;
            padding: 35px 15px;
            color: #333;
        }

        .container {
            max-width: 480px;
            margin: 25px auto;
            background: white;
            padding: 28px;
            border-radius: 8px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
        }

        h1 {
            margin-top: 0;
            color: #1769aa;
            font-size: 25px;
        }

        .subtitle {
            color: #777;
            font-size: 14px;
            margin-bottom: 22px;
        }

        label {
            display: block;
            margin-top: 16px;
            font-weight: bold;
            font-size: 14px;
        }

        input {
            width: 100%;
            padding: 11px;
            margin-top: 7px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
        }

        input:focus {
            outline: none;
            border-color: #1769aa;
        }

        .buttons {
            display: flex;
            gap: 10px;
            margin-top: 24px;
        }

        button, .cancel {
            padding: 11px 16px;
            border: none;
            border-radius: 5px;
            font-size: 14px;
            text-decoration: none;
            cursor: pointer;
        }

        button {
            background: #1769aa;
            color: white;
            flex: 1;
        }

        button:hover {
            background: #10558d;
        }

        .cancel {
            background: #e5e7eb;
            color: #333;
            text-align: center;
        }
    </style>
</head>

<body>

<div class="container">